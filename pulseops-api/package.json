{
  "name": "pulseops-api",
  "version": "1.0.0",
  "private": true,
  "description": "PulseOps — Enterprise Operations Management API. Standalone Kubernetes-ready Express backend with Sequelize ORM.",
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*",
    "#modules/*": "./src/modules/*",
    "#config/*": "./src/config/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:sync": "node src/core/database/sync.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  }
}
