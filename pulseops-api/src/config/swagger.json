          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      }
    },
    "security": [{ "BearerAuth": [] }]
  },
  "apis": ["src/core/routes/*.js", "src/modules/*/routes/*.js"]
}
